tests {
  test("Unsupported method: expected status and contract", function () {
    expect(res.getStatus()).to.equal(405);
    expect(res.getBody().error.code).to.equal("method_not_allowed");
    expect(res.getHeader("allow")).to.equal("GET, POST");
  });
}
