meta {
  name: First page
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/tasks?page=1&limit=2
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("First page: expected status and contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(2);
    expect(res.getBody().pagination.nextPage).to.equal(2);
    expect(res.getBody().data[0].id).to.equal(1);
  });
}
