meta {
  name: Create task
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"title":"Synthetic Bruno task"}
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("createdId", res.getBody().data.id);
}

tests {
  test("Create task: expected status and contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.title).to.equal("Synthetic Bruno task");
    expect(res.getBody().data.id).to.be.a("number");
  });
}
