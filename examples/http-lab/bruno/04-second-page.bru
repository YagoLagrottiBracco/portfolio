meta {
  name: Second page
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/tasks?page=2&limit=2
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("Second page: expected status and contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(2);
    expect(res.getBody().data[0].id).to.equal(3);
  });
}
