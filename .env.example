BLOG_API_KEY=
BLOG_GITHUB_TOKEN=
BLOG_GITHUB_REPOSITORY=YagoLagrottiBracco/portfolio
BLOG_GITHUB_BRANCH=master
# Optional: verification codes from Google Search Console and Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
BLOG_ADMIN_GITHUB_ID=
AUTH_URL=https://lagrotti.dev
# Umami Cloud website ID (cloud.umami.is → Settings → Websites). Empty = no Umami.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Newsletter: Buttondown API key (buttondown.com → Settings → API). Empty = no signup form.
BUTTONDOWN_API_KEY=
# IndexNow uses the committed public ownership key; no runtime secret required.
# UMAMI server values enable /analytics + popular articles AND the local reports.
# Set matching Actions secret/variable for scheduled reports; browser tracking uses
# NEXT_PUBLIC_UMAMI_WEBSITE_ID separately. Explicit self-hosted API base includes /api.
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
UMAMI_API_URL=https://api.umami.is/v1
DEVTO_API_KEY=
# Brief and testimonial forms: Resend API key, the inbox that receives them and a
# sender on a domain verified in Resend. Empty = the forms are not shown.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=lagrotti.dev <contato@lagrotti.dev>
# Article comments with giscus: values from https://giscus.app after enabling
# Discussions on the repository. Empty = no comments section.
NEXT_PUBLIC_GISCUS_REPO=YagoLagrottiBracco/portfolio
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comentários
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# "Ask my portfolio" (Claude). Empty = no /perguntar page. ASK_MODEL defaults to
# claude-opus-5-5; ASK_DAILY_LIMIT caps questions per server instance per day.
ANTHROPIC_API_KEY=
ASK_MODEL=
ASK_DAILY_LIMIT=100
# Browser errors to Sentry (sentry.io → Project → Settings → Client Keys → DSN).
# Also receives the CSP violation reports. Empty = nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: incoming Webmentions persist as pending GitHub issues. Use a dedicated
# fine-grained token for this repository, with Issues read/write; never a broad CLI token.
# webmention.io is separate: only source/target pairs in reviewed references.json render.
WEBMENTION_GITHUB_TOKEN=
WEBMENTION_IO_TOKEN=
# Optional: Broadcast channel links displayed on /assinaturas (/en/assinaturas, /es/assinaturas)
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=


# Optional polls. REST endpoint/token from Upstash; Lua EVAL updates existing JSON atomically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INTERACTIONS_KEY=lagrotti:interactions
# Optional external federation bridge. Native inbox/follower/signature support is absent.
# Configure a bridge WebFinger endpoint and its public actor/outbox URLs.
ACTIVITYPUB_MODE=bridge
ACTIVITYPUB_USERNAME=blog
ACTIVITYPUB_WEBFINGER_URL=
ACTIVITYPUB_ACTOR_URL=
ACTIVITYPUB_OUTBOX_URL=
# WebSub: same public HTTPS hub in Vercel and Actions variable WEBSUB_HUB_URL.
# Empty = no hub advertisement or publication ping.
WEBSUB_HUB_URL=
# Optional local-only social commands. Simulation is default; --publish sends posts.
# Keep these provider credentials out of browser variables and public build assets.
DISTRIBUTE_MAX_AGE_HOURS=48
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_SERVICE=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
# Optional uptime-check target / Actions SITE_URL variable (not the canonical site URL).
SITE_URL=https://lagrotti.dev
