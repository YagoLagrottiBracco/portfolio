BLOG_API_KEY=
BLOG_GITHUB_TOKEN=
BLOG_GITHUB_REPOSITORY=YagoLagrottiBracco/portfolio
BLOG_GITHUB_BRANCH=master
# Optional: verification codes from Google Search Console and Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
BLOG_ADMIN_GITHUB_ID=
AUTH_URL=https://lagrotti.dev
# Umami Cloud website ID (cloud.umami.is → Settings → Websites). Empty = no Umami.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Newsletter: Buttondown API key (buttondown.com → Settings → API). Empty = no signup form.
BUTTONDOWN_API_KEY=
# IndexNow key, 8-128 letters, digits or dashes (`openssl rand -hex 16`). Empty = no key file.
INDEXNOW_KEY=
# Only for the local scripts (report:traffic, umami:funnels, crosspost); the site does not read them.
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
DEVTO_API_KEY=
# Brief and testimonial forms: Resend API key, the inbox that receives them and a
# sender on a domain verified in Resend. Empty = the forms are not shown.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=lagrotti.dev <contato@lagrotti.dev>
# Article comments with giscus: values from https://giscus.app after enabling
# Discussions on the repository. Empty = no comments section.
NEXT_PUBLIC_GISCUS_REPO=YagoLagrottiBracco/portfolio
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comentários
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# "Ask my portfolio" (Claude). Empty = no /perguntar page. ASK_MODEL defaults to
# claude-opus-5-5; ASK_DAILY_LIMIT caps questions per server instance per day.
ANTHROPIC_API_KEY=
ASK_MODEL=
ASK_DAILY_LIMIT=100
# Browser errors to Sentry (sentry.io → Project → Settings → Client Keys → DSN).
# Also receives the CSP violation reports. Empty = nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: Webmention persistence via GitHub Discussions/Issues or webmention.io token
WEBMENTION_GITHUB_TOKEN=
WEBMENTION_IO_TOKEN=
# Optional: Broadcast channel links displayed on /assinaturas (/en/assinaturas, /es/assinaturas)
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=

